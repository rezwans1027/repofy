# =============================================================================
# Repofy Frontend — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
# =============================================================================

# ---------------------------------------------------------------------------
# Backend API (required)
# ---------------------------------------------------------------------------
# URL of the Repofy backend API (including /api path).
# Used for Next.js rewrites and server-side API calls.
# Defaults to http://localhost:3001/api in development.
API_BACKEND_URL=http://localhost:3001/api

# ---------------------------------------------------------------------------
# Supabase (required — for GitHub OAuth)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=<your-supabase-project-url>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>
