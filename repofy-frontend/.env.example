# =============================================================================
# Repofy Frontend — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
# =============================================================================

# ---------------------------------------------------------------------------
# Site URL (used for SEO metadata, sitemap, and OG images)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://repofy.dev

# ---------------------------------------------------------------------------
# Backend API (required)
# ---------------------------------------------------------------------------
# URL of the Repofy backend API (including /api path).
# Used for Next.js rewrites and server-side API calls.
# Defaults to http://localhost:3001/api in development.
API_BACKEND_URL=http://localhost:3001/api

# ---------------------------------------------------------------------------
# GitHub App OAuth (required — for login flow)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GITHUB_APP_CLIENT_ID=<your-github-app-client-id>

# ---------------------------------------------------------------------------
# Supabase (E2E testing only — Playwright seed helpers use PostgREST directly)
# seed.ts reads these unprefixed names from process.env or .env.local
# ---------------------------------------------------------------------------
SUPABASE_URL=<your-supabase-project-url>
SUPABASE_ANON_KEY=<your-supabase-anon-key>

# ---------------------------------------------------------------------------
# Sentry (error monitoring)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=<your-sentry-frontend-dsn>
SENTRY_ORG=<your-sentry-org-slug>
SENTRY_PROJECT=<your-sentry-project-slug>
SENTRY_AUTH_TOKEN=<your-sentry-auth-token>
