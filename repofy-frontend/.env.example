# =============================================================================
# Repofy Frontend — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
# Your Supabase project URL (Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anonymous/public key (Settings > API > anon/public key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ---------------------------------------------------------------------------
# Backend API (optional in dev, required in production)
# ---------------------------------------------------------------------------
# URL of the Repofy backend API (including /api path).
# Defaults to http://localhost:3001/api in development.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ---------------------------------------------------------------------------
# E2E Testing (optional — only needed for running Playwright tests)
# ---------------------------------------------------------------------------
# Credentials for the test user account used by Playwright auth setup
# E2E_TEST_EMAIL=test@example.com
# E2E_TEST_PASSWORD=your-test-password
