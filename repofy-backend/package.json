{
  "name": "repofy-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker:analysis": "node --max-old-space-size=64 dist/workers/analysis-supervisor.js",
    "worker:maintenance": "node --max-old-space-size=128 dist/workers/analysis.js --maintenance",
    "worker:verify": "npm run build && node scripts/jobs/verify.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "node scripts/db/migrate.mjs",
    "test:postgres": "node scripts/db/test-postgres.mjs",
    "rubrics:validate": "node scripts/rubrics/validate.mjs",
    "rubrics:seed:generate": "node scripts/rubrics/validate.mjs --write",
    "ingestion:verify": "node scripts/ingestion/verify.mjs",
    "extraction:verify": "npm run build && node scripts/extraction/verify.mjs",
    "detectors:verify": "npm run build && node scripts/detectors/verify.mjs",
    "coverage:verify": "npm run build && node scripts/coverage/verify.mjs",
    "aggregation:verify": "npm run build && node scripts/aggregation/verify.mjs",
    "synthesis:smoke": "tsx scripts/synthesis/smoke.ts",
    "release:typecheck": "tsc -p tsconfig.release.json",
    "release:benchmark": "tsx scripts/release/benchmark.ts",
    "release:load": "tsx scripts/release/load.ts",
    "release:verify": "node scripts/release/verify.mjs",
    "release:preflight": "tsx scripts/release/preflight.ts",
    "release:decision": "tsx scripts/release/decision.ts"
  },
  "dependencies": {
    "@lezer/common": "1.5.2",
    "@lezer/java": "1.1.4",
    "@lezer/python": "1.1.19",
    "@lezer/xml": "1.0.6",
    "@repofy/contracts": "file:../packages/contracts",
    "@sentry/node": "^10.75.1",
    "@supabase/supabase-js": "^2.95.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "ignore": "7.0.9",
    "ioredis": "^5.10.0",
    "resend": "^6.28.1",
    "smol-toml": "1.8.0",
    "stripe": "^20.3.1",
    "tar": "7.5.22",
    "typescript": "5.9.3",
    "yaml": "2.9.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.12.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "pg": "^8.16.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
