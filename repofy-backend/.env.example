PORT=3101
CORS_ORIGIN=http://localhost:3100
FRONTEND_URL=http://localhost:3100
TRUST_PROXY=false

SUPABASE_URL=<your-project-url>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
SUPABASE_ANON_KEY=<your-supabase-anon-key>

OPENAI_MODEL=gpt-5.1

STRIPE_SECRET_KEY=<your-stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-secret>

RESEND_API_KEY=<your-resend-api-key>

ADMIN_SECRET=<your-admin-secret>

ENGINE_URL=http://localhost:3002
ENGINE_INTERNAL_KEY=<your-engine-internal-key>

# 32-byte hex key for AES-256-GCM encryption of GitHub tokens at rest
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=<64-hex-char-encryption-key>

# GitHub App OAuth (repofy.dev login flow)
GITHUB_APP_CLIENT_ID=<your-github-app-client-id>
GITHUB_APP_CLIENT_SECRET=<your-github-app-client-secret>

# Feature 1 remains unavailable during foundation work; no client-side overrides.
FEATURE_ONE_ENABLED=false
GITHUB_APP_REPOSITORIES_ENABLED=false
RESCANS_ENABLED=false
FINDING_FEEDBACK_ENABLED=false
# Independent provenance rollout; affects new analyses only (aggregation 1.1.0).
FEATURE_ONE_PROVENANCE_ENABLED=false
# Required only when FEATURE_ONE_ENABLED and GITHUB_APP_REPOSITORIES_ENABLED are true.
# Inject the private key from the deployment's managed secret service; never commit it.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# Sentry (error monitoring)
SENTRY_DSN=<your-sentry-backend-dsn>
# Feature 1 locator persistence (lazy; required only by ingestion/worker writes).
# Provision independent 32-byte hex keys from a managed secret service; never reuse OAuth/token keys.
# EVIDENCE_LOCATOR_KEY_VERSION=1.0.0
# EVIDENCE_LOCATOR_ENCRYPTION_KEY=
# EVIDENCE_FINGERPRINT_KEY=

# Maximum saved repositories per user (1–10). Authoritative server policy.
FEATURE_ONE_MAX_REPOSITORIES=5
# Keep GITHUB_APP_WEBHOOK_SECRET configured when disabling intake flags.

# Run 07: explicit internal zero-cost analysis entitlement; requires complete checked-in handlers.
FEATURE_ONE_ANALYSIS_ALLOWLIST=
# Dedicated private directory shared with this host's maintenance service (0700).
# FEATURE_ONE_WORKSPACE_ROOT=/var/lib/repofy/ingestion
# Run 12: opt-in only after provider smoke, data handling, UI and rollout gates.
# Deployment configuration is allowlisted; an arbitrary model/host is not accepted.
FEATURE_ONE_SYNTHESIS_ENABLED=false
FEATURE_ONE_MODEL_PROVIDER=openai
FEATURE_ONE_MODEL=gpt-4.1-mini-2025-04-14
FEATURE_ONE_MODEL_POLICY=bounded_narrative_1.0.0
# Set only after reviewing docs/adr/0012-validated-narratives.md. This does not claim ZDR.
FEATURE_ONE_PROVIDER_DATA_POLICY=
# OPENAI_API_KEY must be supplied through the deployment secret store (never committed).
